# Python bytecode and caches
__pycache__/
*.py[cod]
*$py.class

# Virtual environments
.venv/
venv/
env/
ENV/

# Python tooling caches
.pytest_cache/
.mypy_cache/
.ruff_cache/

# Notebook checkpoints
.ipynb_checkpoints/

# Editor / OS files
.vscode/
.idea/
*.swp
*.swo
.DS_Store

# Project-generated outputs
resultModel/
tensorboardModel/
modelpath/

# Raw mocap exports can be large and are usually regenerated outside the repo.
mocap_data/*.json
!mocap_data/*_targets_summary.json
